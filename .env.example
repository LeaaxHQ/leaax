# Copy this file to .env.local and fill in your own values.
# Never commit real keys — .env* is already gitignored.

# API key for the Brave Search API (https://api-dashboard.search.brave.com/).
# Required for the /api/check endpoint to actually perform searches.
# Free tier is sufficient to get started.
BRAVE_SEARCH_API_KEY=

# The email-breach check (/api/check-email) uses the XposedOrNot API
# (https://xposedornot.com/api_doc). Its free single-email "check-email"
# lookup is keyless as of this writing — no env var needed here. If a
# future tier of their API requires a key, add it as
# XPOSEDORNOT_API_KEY= here and wire it up in src/lib/breach/xposedornot.ts
# (never hardcode it in source).
